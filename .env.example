# 複製成 .env 並填入
ANTHROPIC_API_KEY=sk-ant-...
MINIMAX_API_KEY=...
# 選填：缺少時新聞自動降級為 yfinance news
FINNHUB_API_KEY=
# SEC EDGAR 要求 User-Agent 帶聯絡方式
EDGAR_USER_AGENT="Cyber-Sages research bot you@example.com"
# 台股（FinMind）：無 token 也能打但限流很緊，建議到 finmindtrade.com 免費註冊
FINMIND_TOKEN=
# 總經（FRED）：到 fred.stlouisfed.org 免費申請；缺少時自動跳過總經分析師
FRED_API_KEY=
